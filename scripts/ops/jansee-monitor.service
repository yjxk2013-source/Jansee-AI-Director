[Unit]
Description=JANSEE cloud monitor (resource + ffmpeg + billing)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/jansee
ExecStart=/usr/bin/node /srv/jansee/scripts/ops/cloud-monitor.mjs
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
