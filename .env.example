# ==============================================================================
# 简兮 (JANSEE) — 商业级生产环境配置示例模板 (.env.example)
# 复制此文件为 .env 并填入实际商业化密钥，严禁提交 .env 到 Git 仓库
# ==============================================================================

# 基础运行时
NODE_ENV=production
PORT=5173
HOST=0.0.0.0

# 业务安全与硬性风控
JWT_SECRET=your_jwt_secret_min_32_chars_here
TOKEN_EXPIRES_DAYS=7
MAX_PRODUCT_IMAGES_LIMIT=9
DEFAULT_CREDITS_PER_TASK=10

# AI 大模型编排引擎 (用于生成分镜剧本与智能文案)
# 支持 DeepSeek-V3 / 硅基流动 SiliconFlow / 本地模型网关
LLM_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-your-siliconflow-api-key-here
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 语音合成与转写引擎 (TTS / ASR)
TTS_PROVIDER=edge_tts
ASR_PROVIDER=whisper_local
WHISPER_MODEL_PATH=./storage/models/ggml-base.bin

# 视听合成引擎与硬件加速 (FFmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HWACCEL_MODE=auto # auto / nvenc / qsv / cpu

# 云端对象存储 (用于存储海量成片与用户素材)
STORAGE_DRIVER=local # local / aliyun_oss / tencent_cos
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=jansee-media
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 商业支付接入 (微信支付 V3 / 支付宝)
# WXPAY_MCH_ID=
# WXPAY_APP_ID=
# WXPAY_API_V3_KEY=
# WXPAY_SERIAL_NO=
