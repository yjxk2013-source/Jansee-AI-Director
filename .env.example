NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
# Heavy media jobs per API process; V2 production baseline is 2 (V4 hard-caps at 2).
WORKER_CONCURRENCY=2
# Production must set the exact private reverse-proxy IP; Compose overrides this with its fixed Nginx address.
TRUST_PROXY_IP=
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
APP_VERSION=4.0.0-alpha.1

# Comma-separated administrator email allowlist. Empty means admin APIs are denied.
ADMIN_EMAILS=admin@example.com

# Optional OpenAI-compatible AI Director provider (server-side only).
# Use a mainland-reachable provider endpoint for mainland China production.
# V2 baseline: 90s total budget per model attempt (V2 director.mjs: first-packet 30s + total 90s).
# GLM is the primary model and empirically fastest; keep the primary budget generous to avoid needless fallback.
DIRECTOR_API_BASE_URL=https://api.siliconflow.cn/v1
DIRECTOR_API_KEY=
DIRECTOR_MODEL=zai-org/GLM-5.3-Flash
DIRECTOR_FALLBACK_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,Pro/deepseek-ai/DeepSeek-V3,Qwen/Qwen2.5-14B-Instruct
DIRECTOR_TIMEOUT_MS=90000
DIRECTOR_FALLBACK_TIMEOUT_MS=90000
DIRECTOR_MAX_TOKENS=1200
DIRECTOR_THINKING_BUDGET=512

# Private PostgreSQL container for the initial single-server deployment.
# Generate a unique 64-character hex password (openssl rand -hex 32); keep it only in server .env.
POSTGRES_PASSWORD=
# Compose injects DATABASE_URL to the private postgres service.
# For a separately managed PostgreSQL service, set DATABASE_URL and DATABASE_SSL=true.
DATABASE_URL=
# Local PGlite: use 4; dedicated PostgreSQL: 10 is a reasonable initial pool size.
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_PRIVATE_NETWORK=true

# Persistent media storage driver: local (private disk) or cos (Tencent COS + local render cache).
MEDIA_STORAGE_DRIVER=local
# Local driver: dedicated private V4 object root. COS driver: optional fallback cache root.
# Windows example: F:\Jansee-v4-storage
# Linux/container example: /srv/jansee-v4/media
MEDIA_STORAGE_ROOT=
# Required for COS driver; an absolute, private local scratch/cache path.
MEDIA_CACHE_ROOT=
MEDIA_MIN_FREE_BYTES=1073741824

# Dedicated private Tencent COS bucket (V4 only).
# Keep credentials server-side; never expose them to the browser or commit real values.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_UPLOAD_URL_TTL_SECONDS=300
COS_DOWNLOAD_URL_TTL_SECONDS=300

# Local Whisper ASR (audio transcription only; Linux production binary must match host architecture).
JX_WHISPER_CLI=
JX_WHISPER_MODEL=
JX_MATERIALS_ROOT=materials

# Tencent Cloud TTS (Voice Synthesis Provider - 8 million free characters)
JX_TTS_TENCENT_SECRET_ID=
JX_TTS_TENCENT_SECRET_KEY=
JX_TTS_TENCENT_SPEED_BASE=0.79

# OPCPAY / 一人付 (server-side Alipay entitlement and quota provider)
# API Key and webhook secret are issued by the OPCPAY project console.
OPCPAY_API_KEY=
OPCPAY_WEBHOOK_SECRET=
# Optional override for isolated provider testing; production should use the official HTTPS API.
OPCPAY_BASE_URL=
PAY_SIMULATE=1

# SMS Service (Aliyun Dypnsapi 号码认证短信通道)
# Must remain 0 in production; API startup rejects mock/test SMS mode.
JX_AUTH_TEST=0
JX_SMS_PROVIDER=aliyun
JX_SMS_SECRET_ID=
JX_SMS_SECRET_KEY=
JX_SMS_SIGN_NAME=恒创联众
JX_SMS_TEMPLATE_CODE=100001
JX_SMS_VALID_MIN=10

# Required in production before partner payout profiles can be stored.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable across deployments and back it up securely; never commit the real value.
PARTNER_PAYOUT_ENCRYPTION_KEY=

# Optional per-model prices in CNY per 1M tokens; leave unset to show cost as unavailable.
# Example: {"zai-org/GLM-5.3-Flash":{"inputPerMillionYuan":0.0,"outputPerMillionYuan":0.0}}
# Configure exact provider model IDs and current contract prices; no default price is assumed.
DIRECTOR_MODEL_PRICING_JSON=
