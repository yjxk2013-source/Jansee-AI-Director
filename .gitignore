# ==============================================================================
# 简兮 (JANSEE) V3 企业级全量私有仓库 .gitignore
# 架构规范：大厂级全量灾备（纯代码 + 字体 + 模板 + 文档 + 运营工具归入 Git）
# 官方 1.3GB 音频曲库由 `npm run sync:materials` 自动从云端一键极速补全
# ==============================================================================

# 依赖与临时编译
node_modules/
**/node_modules/
.pnpm-store/
dist/
build/
.cache/
*.tsbuildinfo
*.bak
*.tmp

# 移动端编译与本地 SDK 路径
.gradle/
**/android/.gradle/
**/android/local.properties
*.keystore
*.jks

# 环境变量与敏感密钥保护（避免泄漏真实私钥，请从 .env.example 复制配置）
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
.alipay-*.json

# 业务运行时敏感数据隔离（订单、用户、积分与账本数据严禁入库）
apps/web/server/data/*.json
!apps/web/server/data/.gitkeep

# 运行时临时存储与历史备份隔离
storage/outputs/*
!storage/outputs/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
storage/temp/*
storage/_backup*
storage/backups/
_backup/
temp/
tmp/
scratch/
*.log
*.bundle

# 大型音视频二进制与打包产物（由云端灾备一键同步，严禁入库）
materials/audio/
whisper.cpp/
COO/素材/录屏/
COO/素材/切片/
COO/工具/tmp_subs/
*.apk
*.aab
*.mp4
*.mov
*.avi
*.m4v
apps/web/client/assets/*.mp4
apps/web/client/assets/app/*.apk

# 编辑器与系统临时文件
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini
