# JANSEE V4 standalone release image
# Uses pre-built dist/ artifacts from host `npm run build`

FROM node:22-bookworm-slim AS api
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=4100
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 && rm -rf /var/lib/apt/lists/*
COPY deploy/bin/ffmpeg-6.1.3 /usr/local/bin/ffmpeg
COPY package.json ./package.json
COPY packages ./packages
COPY modules ./modules
COPY apps/api/package.json ./apps/api/package.json
COPY apps/api/dist ./apps/api/dist
COPY apps/api/migrations ./apps/api/migrations
RUN mkdir -p /app/storage/media /app/storage/cache
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:4100/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh","-c","mkdir -p node_modules/ffmpeg-static && ln -sf /usr/local/bin/ffmpeg node_modules/ffmpeg-static/ffmpeg && exec node --import tsx apps/api/dist/server.js"]

FROM nginx:1.27-alpine AS web
COPY apps/web/dist/ /usr/share/nginx/html/
COPY deploy/nginx-v4.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD wget -qO- http://127.0.0.1/health/web >/dev/null || exit 1
