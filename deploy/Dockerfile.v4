# JANSEE V4 standalone release image
# Build: docker compose -f deploy/docker-compose.v4.yml build
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
COPY materials ./materials
COPY tsconfig.json tsconfig.base.json ./
COPY tests ./tests
COPY scripts ./scripts
RUN npm ci
RUN npm run build
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS api
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=4100
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/modules ./modules
COPY --from=build /app/materials ./materials
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
# The API runs database migrations during startup; ship the SQL files beside dist/.
COPY --from=build /app/apps/api/migrations ./apps/api/migrations
RUN mkdir -p /app/storage/media /app/storage/cache /app/whisper.cpp/bin /app/whisper.cpp/models
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:4100/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/server.js"]

FROM nginx:1.27-alpine AS web
COPY --from=build /app/apps/web/dist/ /usr/share/nginx/html/
COPY deploy/nginx-v4.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD wget -qO- http://127.0.0.1/health/web >/dev/null || exit 1
