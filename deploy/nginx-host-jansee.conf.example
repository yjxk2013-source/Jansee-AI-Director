# JANSEE V4 host-level HTTPS reverse proxy
# Install as /etc/nginx/conf.d/jansee-v4.conf on the Linux host.
# The TLS certificate must cover: jansee.cn, admin.jansee.cn, www.jansee.cn.
# The V4 web container must remain bound to 127.0.0.1:8080 only.

server {
    listen 80;
    listen [::]:80;
    server_name jansee.cn admin.jansee.cn;
    return 301 https://$host$request_uri;
}

# www is an alias only; consolidate all public traffic to the canonical bare domain.
server {
    listen 80;
    listen [::]:80;
    server_name www.jansee.cn;
    return 301 https://jansee.cn$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.jansee.cn;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/jansee.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jansee.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://jansee.cn$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jansee.cn admin.jansee.cn;
    server_tokens off;
    client_max_body_size 500m;

    ssl_certificate     /etc/letsencrypt/live/jansee.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jansee.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Overwrite client-supplied forwarding headers at the trusted edge.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";

        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }
}
