NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4100
# Heavy media jobs per API process; lower to 1 if host memory pressure is observed.
WORKER_CONCURRENCY=2
LOG_LEVEL=info
WEB_ORIGINS=https://jansee.cn,https://admin.jansee.cn
TRUST_PROXY_IP=172.30.250.2
ADMIN_EMAILS=

# Required by docker-compose.v4.yml. Generate a unique 64-character hex value and back it up.
POSTGRES_PASSWORD=
DATABASE_SSL=false
DATABASE_PRIVATE_NETWORK=true

# AI Director. Keep provider credentials server-side.
DIRECTOR_API_BASE_URL=https://api.siliconflow.cn/v1
DIRECTOR_API_KEY=
DIRECTOR_MODEL=zai-org/GLM-5.3-Flash
DIRECTOR_FALLBACK_MODELS=deepseek-ai/DeepSeek-V4.1-Flash
DIRECTOR_TIMEOUT_MS=25000
DIRECTOR_FALLBACK_TIMEOUT_MS=30000
DIRECTOR_MAX_TOKENS=2048

# Tencent Cloud TTS.
JX_TTS_TENCENT_SECRET_ID=
JX_TTS_TENCENT_SECRET_KEY=
JX_TTS_TENCENT_SPEED_BASE=0.79

# Aliyun SMS. Mock/test mode is forbidden in production.
JX_AUTH_TEST=0
JX_SMS_PROVIDER=aliyun
JX_SMS_SECRET_ID=
JX_SMS_SECRET_KEY=
JX_SMS_SIGN_NAME=
JX_SMS_TEMPLATE_CODE=
JX_SMS_VALID_MIN=10

# OPCPAY / 一人付. API key is mandatory; webhook signing secret is optional (polling reconciliation remains available).
OPCPAY_API_KEY=
OPCPAY_WEBHOOK_SECRET=
OPCPAY_BASE_URL=
PAY_SIMULATE=0

# 媒体存储配置（全面接入腾讯云对象存储与 CDN 边缘加速）
MEDIA_STORAGE_DRIVER=cos
MEDIA_STORAGE_ROOT=/app/storage/media
MEDIA_CACHE_ROOT=/app/storage/cache
MEDIA_MIN_FREE_BYTES=1073741824
# 腾讯云 COS 存储桶配置与 CDN 加速域名
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=jansee-1460392374
COS_REGION=ap-guangzhou
COS_CDN_DOMAIN=cdn.jansee.cn
COS_CDN_AUTH_KEY=
CDN_BASE_URL=https://cdn.jansee.cn
JX_WHISPER_CLI=/app/whisper.cpp/bin/whisper-cli
JX_WHISPER_MODEL=/app/whisper.cpp/models/ggml-small.bin
JX_MATERIALS_ROOT=/app/materials

# Stable AES-256 key for partner payout details. Generate once, securely back up, never rotate casually.
PARTNER_PAYOUT_ENCRYPTION_KEY=
